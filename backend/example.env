# Copy this file to backend/.env and fill in the values.
# Every variable below is required unless marked optional - the app fails to start if one is missing.
# Third-party keys can be left as dummy placeholders for local development; the features that use
# them will fail at call time, but the app will boot.

# Database settings
DATABASE_HOSTNAME=localhost
DATABASE_PORT=5432
DATABASE_PASSWORD=your_postgres_password
DATABASE_NAME=jam
DATABASE_USERNAME=postgres

# JWT settings
# Generate SECRET_KEY with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=replace_me_with_a_random_secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=61200

# App settings
MAX_FILE_SIZE_MB=10
MAX_SCRAPING_DESCRIPTION_LENGTH=10000
MIN_SCRAPING_DESCRIPTION_LENGTH=100
MAX_SCRAPING_TITLE_LENGTH=1000
MAX_SCRAPING_COMPANY_LENGTH=1000
SCRAPE_MAX_RETRY=3
SCRAPE_RETRY_DELAY_HOURS=5
RATING_MAX_RETRY=3
RATING_RETRY_DELAY_HOURS=5

# Other settings
# LOG_DIRECTORY is an absolute path to an existing, writable directory
LOG_DIRECTORY=/absolute/path/to/jam/logs
TEST_MODE=False
MIN_PASSWORD_LENGTH=8
MONTHLY_SCRAPE_QUOTA=1500

# URL configurations
FRONTEND_URL=http://localhost:3000/jam
BACKEND_URL=http://localhost:8000

# Email settings
EMAIL_SMTP_PORT=587
EMAIL_SMTP_HOST=smtp.example.com
EMAIL_IMAP_PORT=993
EMAIL_IMAP_HOST=imap.example.com
MAIN_EMAIL_USERNAME=jam@example.com
MAIN_EMAIL_PASSWORD=your_mailbox_password
SCRAPER_EMAIL_USERNAME=jam.jobscraper@example.com
SCRAPER_EMAIL_PASSWORD=your_mailbox_password
INFO_EMAIL=jam.info@example.com
SUPPORT_EMAIL=jam.support@example.com

# Verification settings
VERIFICATION_TOKEN_EXPIRATION_MINUTES=60
EMAIL_CHANGE_TOKEN_EXPIRATION_MINUTES=60
PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30
VERIFICATION_EMAIL_MIN_INTERVAL_SECONDS=120

# Brightdata - https://brightdata.com (job scraping)
BRIGHTDATA_API_KEY=your_brightdata_api_key

# Apify - https://apify.com (job scraping)
APIFY_API_KEY=apify_api_your_key

# Stripe - https://dashboard.stripe.com (payments)
STRIPE_API_KEY=sk_test_your_stripe_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret
STRIPE_TOAST_PRICE_ID=price_your_price_id

# Anthropic - https://console.anthropic.com (job rating)
# ANTHROPIC_ADMIN_KEY is only used by provider usage/cost monitoring
ANTHROPIC_API_KEY=sk-ant-api03-your-key
ANTHROPIC_ADMIN_KEY=sk-ant-admin01-your-key

# Cloudflare Turnstile - https://dash.cloudflare.com (signup bot protection)
TURNSTILE_SITE_KEY=your_turnstile_site_key
TURNSTILE_SECRET_KEY=your_turnstile_secret_key
