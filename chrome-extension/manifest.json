{
	"manifest_version": 3,
	"name": "JAM",
	"version": "1.0.0",
	"description": "Save LinkedIn job listings to JAM with one click.",
	"permissions": ["storage", "activeTab", "tabs", "scripting"],
	"host_permissions": ["https://www.linkedin.com/jobs/view/*", "https://www.linkedin.com/jobs/collections/*"],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"content_scripts": [
		{
			"matches": ["https://www.linkedin.com/jobs/view/*", "https://www.linkedin.com/jobs/collections/*"],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
