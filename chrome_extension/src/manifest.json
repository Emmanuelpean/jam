{
	"manifest_version": 3,
	"name": "SPREAD",
	"version": "1.0.0",
	"description": "Save LinkedIn, Indeed and other platform job listings to JAM with one click.",
	"permissions": ["storage", "activeTab", "tabs", "scripting"],
	"host_permissions": [
		"https://www.linkedin.com/jobs/view/*",
		"https://www.linkedin.com/jobs/collections/*",
		"https://*.indeed.com/*",
		"https://www.jobs.nhs.uk/*",
		"https://veganjobs.com/*"
	],
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"content_scripts": [
		{
			"matches": [
				"https://www.linkedin.com/jobs/view/*",
				"https://www.linkedin.com/jobs/collections/*",
				"https://*.indeed.com/*",
				"https://www.jobs.nhs.uk/candidate/jobadvert/*",
				"https://veganjobs.com/job/*"
			],
			"js": ["content.js"],
			"run_at": "document_idle"
		}
	],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
