# Copy this file to frontend/.env.

# Backend API (uvicorn on port 8000)
VITE_API_BASE_URL="http://localhost:8000"

# Background scheduler process (uvicorn on port 8001)
VITE_API_SERVICE_URL="http://localhost:8001"

VITE_ENABLE_ANALYTICS=false

# CARTO basemap tiles - request a key at https://carto.com/basemaps/apikey
# Baked into the bundle and visible in tile URLs; optional, tiles load unkeyed without it
VITE_CARTO_API_KEY=your_carto_api_key